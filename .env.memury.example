MEMURY_DEMO_MODE=true
# Runtime AI settings for Memury. Keep real secrets out of Git and the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.krill-ai.net/codex/v1
MEMURY_AI_MODEL=gpt-5.4
MEMURY_AI_ENABLED=false
# Optional timeout overrides in seconds.
MEMURY_AI_OPEN_TIMEOUT_SECONDS=5
MEMURY_AI_READ_TIMEOUT_SECONDS=20
MEMURY_AI_WRITE_TIMEOUT_SECONDS=10
MEMURY_AI_MAX_OUTPUT_TOKENS=500
